# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — never commit it.

wifi_ssid: "YourNetwork"
wifi_password: "your-wifi-password"

# Password for the fallback access point the device raises when it cannot
# reach your network. Minimum 8 characters.
ap_password: "changeme123"

# Home Assistant API encryption key.
# Generate with:  openssl rand -base64 32
api_key: "REPLACE_WITH_BASE64_KEY"

# Password for over-the-air updates.
ota_password: "changeme"
